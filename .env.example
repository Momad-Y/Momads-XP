# Momad's XP — server environment variables
#
# Used only by the /api/email Netlify Function (SvelteKit endpoint).
# For local testing copy to `.env` (gitignored); in production they are set
# on the Netlify site (momad-xp → Site configuration → Environment variables).
# NOTE: Netlify functions bake env at deploy time — changing a var requires
# a redeploy to take effect.

# Resend API key (sending-only permission is enough). Create at
# https://resend.com/api-keys — never commit the real value.
RESEND_API_KEY=

# Optional sender address. Leave empty to use Resend's sandbox sender
# (onboarding@resend.dev — only delivers to the Resend account's own email).
# Set to an address on a verified domain (https://resend.com/domains) once
# a custom domain exists (planned Phase 6).
EMAIL_FROM=
