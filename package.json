{
  "name": "web-svelte",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky && svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jhubbardsf/svelte-sortablejs": "^1.1.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.7",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "^8.4.14",
    "postcss-load-config": "^4.0.1",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.2",
    "svelte-preprocess": "^5.0.0",
    "tailwindcss": "^3.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "dependencies": {
    "@types/lodash": "^4.14.186",
    "axios": "^0.27.2",
    "buffer": "^6.0.3",
    "build-url": "^6.0.1",
    "dragselect": "^2.5.5",
    "fast-sort": "^3.2.1",
    "file-saver": "^2.0.5",
    "hash-sum": "^2.0.0",
    "idb-keyval": "^6.2.0",
    "is-valid-http-url": "^1.0.3",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "short-uuid": "^4.2.2",
    "srt-webvtt": "^2.0.0",
    "svelte-range-slider-pips": "^2.0.3",
    "tailwindcss-scoped-groups": "^2.0.0"
  },
  "lint-staged": {
    "*.{ts,js,svelte}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
